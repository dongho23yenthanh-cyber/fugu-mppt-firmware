# Template for .claude/memory/secrets.env — copy to secrets.env and fill in.
# The memory notes under .claude/memory/ reference these as $VAR placeholders.
#   cp .claude/memory/secrets.env.example .claude/memory/secrets.env
#   set -a; . .claude/memory/secrets.env; set +a

# Wokwi simulator headless CI token (wokwi-cli) — see reference_wokwi_cli_token.md
WOKWI_CLI_TOKEN=wok_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# InfluxDB v1 db holding firmware mppt telemetry
INFLUX_HA_VAN_USER=your_influx_user
INFLUX_HA_VAN_PASS=your_influx_pass

# MQTT broker the converters publish status/log to
MQTT_BROKER_USER=your_mqtt_user
MQTT_BROKER_PASS=your_mqtt_pass

# Lab WiFi for bench testing (shared PSK across the SSIDs)
LAB_WIFI_SSID=your_lab_ssid
LAB_WIFI_SSID2=your_other_lab_ssid
LAB_WIFI_SSID3=your_third_lab_ssid
LAB_WIFI_PSK=your_lab_wifi_psk
