menu "Fugu MPPT firmware"

# Build-time feature flags. These replace the old WITH_* env-var build flags; the CMake build
# reads CONFIG_FUGU_WITH_* and re-emits the matching WITH_* compile define + selects the source
# files / sdkconfig fragments. Toggle with `idf.py menuconfig` or an sdkconfig(.defaults) fragment.

config FUGU_WITH_NETW
    bool "Networking (WiFi / mDNS / MQTT / telemetry / HTTPS-OTA)"
    default y
    help
        Compile the WiFi/mDNS/MQTT/telemetry/HTTPS-OTA path. When off, the firmware runs the
        UART/USB/BLE consoles only and the linker garbage-collects wifi/lwip/mbedtls/esp-tls.

if FUGU_WITH_NETW

config FUGU_WITH_NETTOOLS
    bool "Network debug tools (curl / ping console commands)"
    default n
    select MBEDTLS_CERTIFICATE_BUNDLE
    help
        Compile the `curl <url>` (blocking HTTP(S) GET, prints the body) and `ping <host>`
        console commands. Debug tools — they reuse the WiFi/HTTP/lwip stack already linked by
        NETW, plus the mbedTLS certificate bundle (~50 KB flash) so HTTPS verifies.

endif # FUGU_WITH_NETW

config FUGU_WITH_BLE
    bool "BLE NUS console + OTA (NimBLE)"
    default y
    select BT_ENABLED
    help
        NimBLE console + OTA push. Adds ~250 KB flash. The NimBLE host selection and radio/thermal
        tunings that Kconfig can't default from here live in sdkconfig.ble, layered by CMakeLists
        when this is on.

config FUGU_WITH_MCPWM
    bool "MCPWM gate driver (instead of LEDC)"
    default n
    help
        Drive the half-bridge with the MCPWM peripheral (hardware dead-time, OST brake, glitch-free
        comparator updates) instead of LEDC. See doc/mcpwm-sync-buck-driver.md.

config FUGU_WITH_VCONV
    bool "Virtual converter plant (simulation, no hardware)"
    default n
    depends on !FUGU_WITH_MCPWM
    help
        Replace the physical gate driver + ADC with a software converter plant (src/sim/vconv.*).
        Mutually exclusive with the MCPWM driver.

config FUGU_WITH_SPROFILER
    bool "Semihosting sampling profiler"
    default n
    help
        Compile the semihosting sampling profiler (only useful with OpenOCD attached). When off the
        whole esp32-semihosting-profiler component is excluded (flash + ~8 KB .bss).

config FUGU_WITH_MEASURE_COIL
    bool "On-device coil inductance measurement"
    default n
    help
        Compile the on-device coil L0/Ls sweep + `measure-coil` console command. Bench-only tool.

config FUGU_INA226_MEASURED_RATE
    bool "INA226: report measured conversion rate (not nominal)"
    default n
    help
        ADC_INA226::getSamplingRate() normally returns the nominal rate derived from the
        configured conversion time (1e6 / (2*conv_time_us)). Some INA226 chips (notably
        counterfeit parts) convert faster than their datasheet timing, so the nominal rate
        underestimates the real sample rate — which mistunes anything keyed to it (the
        inverter-ripple notch's reported frequency, the expected_hz loop-rate watchdog).
        When set, getSamplingRate() instead returns a rate measured over several conversions
        at operational settings during init, so it reflects the chip's actual throughput.

endmenu
